  "sql": {
    "row_diff": "SELECT b.txn_id, b.kind, b.amount AS base_amount, h.amount AS head_amount,\n       ROUND(h.amount - b.amount, 2) AS delta\nFROM workspace.ripple.clean_transactions b\nJOIN workspace.ripple.clean_transactions h\n  ON b.txn_id = h.txn_id AND b.run_id = h.run_id\nWHERE b.run_id = '268c4ec..demo/abs-normalize@20260906T095345Z' AND b.version = 'base' AND h.version = 'head'\n  AND NOT (b.amount <=> h.amount)\nORDER BY b.txn_id",
    "agg_diff": "SELECT b.txn_date, b.net_revenue AS base_net_revenue, h.net_revenue AS head_net_revenue,\n       ROUND(h.net_revenue - b.net_revenue, 2) AS delta\nFROM workspace.ripple.daily_revenue b\nJOIN workspace.ripple.daily_revenue h\n  ON b.txn_date = h.txn_date AND b.run_id = h.run_id\nWHERE b.run_id = '268c4ec..demo/abs-normalize@20260906T095345Z' AND b.version = 'base' AND h.version = 'head'\n  AND NOT (b.net_revenue <=> h.net_revenue)\nORDER BY b.txn_date",
    "summary": "SELECT\n  (SELECT COUNT(*) FROM workspace.ripple.clean_transactions WHERE run_id = '268c4ec..demo/abs-normalize@20260906T095345Z' AND version = 'base') AS rows_base,\n  (SELECT COUNT(*) FROM workspace.ripple.clean_transactions WHERE run_id = '268c4ec..demo/abs-normalize@20260906T095345Z' AND version = 'head') AS rows_head,\n  (SELECT ROUND(SUM(net_revenue), 2) FROM workspace.ripple.daily_revenue WHERE run_id = '268c4ec..demo/abs-normalize@20260906T095345Z' AND version = 'base') AS total_base,\n  (SELECT ROUND(SUM(net_revenue), 2) FROM workspace.ripple.daily_revenue WHERE run_id = '268c4ec..demo/abs-normalize@20260906T095345Z' AND version = 'head') AS total_head"
  },
